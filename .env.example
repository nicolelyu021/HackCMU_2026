# Pinlog — copy to .env at the repo root (cp .env.example .env).
# Everything is optional: with no .env at all the whole app runs in mock mode with zero network calls.

# Provider mode. mock = fixtures only. live = real providers; any provider whose key is missing falls back to mock (with a warning).
PINLOG_MODE=mock

# Per-provider overrides: (mock | anthropic), (mock | nominatim), (mock | openai)
# PINLOG_LLM=anthropic
# PINLOG_PLACES=nominatim
# PINLOG_TTS=openai

# Record real LLM responses under data/replays and replay them later without keys: off | record | replay
# PINLOG_LLM_REPLAY=off

# Keys (never commit a real .env)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_API_KEY=sk-...
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Nominatim's usage policy asks for a contact address in the User-Agent (1 request/second, cached)
# NOMINATIM_EMAIL=you@andrew.cmu.edu

# API (defaults shown)
# PINLOG_API_PORT=8787
# PINLOG_PUBLIC_URL=http://localhost:8787
# PINLOG_WEB_ORIGIN=http://localhost:3000
# PINLOG_DATA_DIR=/absolute/path/to/data        # default: <repo>/data (sqlite db + uploaded files)
# PINLOG_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Web — Next.js only reads NEXT_PUBLIC_* from apps/web/.env*, and the defaults in apps/web/src/lib/config.ts match these
# NEXT_PUBLIC_API_URL=http://localhost:8787
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Auth0 (docs/AUTH.md) — the one part of Pinlog with no mock fallback: the web app refuses to serve a page
# without these. They live in apps/web/.env.local, NOT in this root .env, because Next.js reads them.
# `pnpm auth0:setup` creates the application and writes that file for you.
# AUTH0_DOMAIN=your-tenant.us.auth0.com     # bare hostname, no https://
# AUTH0_CLIENT_ID=...
# AUTH0_CLIENT_SECRET=...
# AUTH0_SECRET=...                          # cookie encryption key: openssl rand -hex 32
# APP_BASE_URL=http://localhost:3000        # must match the Allowed Callback URL's origin
