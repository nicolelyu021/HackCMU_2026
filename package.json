{
  "name": "pinlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green --kill-others-on-fail \"pnpm --filter @pinlog/api dev\" \"pnpm --filter @pinlog/web dev\"",
    "dev:api": "pnpm --filter @pinlog/api dev",
    "dev:web": "pnpm --filter @pinlog/web dev",
    "studio": "pnpm --filter @pinlog/video studio",
    "seed": "pnpm --filter @pinlog/api seed",
    "seed:reset": "pnpm --filter @pinlog/api seed --reset",
    "typecheck": "pnpm -r --parallel --no-bail typecheck && node scripts/check-deps.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "render": "pnpm --filter @pinlog/video render",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
